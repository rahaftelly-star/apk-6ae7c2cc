name: Convert Website to APK
on:
  push:
    branches: [ main ]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v2
    - name: Website to APK Action
      uses: darkshredder/web-to-app-action@v1.0.0
      with:
        build-folder-path: build/
        app-name: MyApp
